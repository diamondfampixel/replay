# ---------------------------------------------------------------------------
# Halyard environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Required — PostgreSQL connection string used at runtime. On Neon/Vercel use the
# POOLED string here (host contains "-pooler").
DATABASE_URL="postgresql://user:password@localhost:5432/halyard_dev?schema=public"

# Direct (non-pooled) connection used only by `prisma migrate deploy`. Vercel's
# Neon integration sets it automatically; leave empty for a local Postgres.
DATABASE_URL_UNPOOLED=

# Required — random 32+ char string used to sign session cookies
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI assistant (optional — the assistant is disabled without this)
# Get a key at https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Same key under a deployment-specific name — used when ANTHROPIC_API_KEY would
# collide with other tooling on the host. Either variable works.
HALYARD_ANTHROPIC_KEY=""
# Model used by the business assistant
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Stripe (optional) — powers both Halyard subscription billing and, later,
# merchant checkout. Without keys, plan changes are local and free and checkout
# stays simulated; the UI says so. After setting the secret key, run
# `npx tsx scripts/stripe-setup.ts` once to create products/prices/coupons,
# and point a webhook at /api/billing/webhook to fill STRIPE_WEBHOOK_SECRET.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Email delivery (optional). Powers store campaigns AND platform emails —
# signup verification and password-reset links. Without it, campaigns can only
# be drafted, new accounts are auto-verified, and reset links appear on-screen
# in development only.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=""

# ---------------------------------------------------------------------------
# Media storage (optional — falls back to local disk under ./public/uploads)
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# ---------------------------------------------------------------------------
# Operations (optional)
# ---------------------------------------------------------------------------
# Any JSON webhook (Slack/Discord compatible) that should receive server errors
MONITORING_WEBHOOK_URL=""
# Upstash Redis REST credentials — makes rate limits hold across serverless
# instances. Without them, limits are per-instance (fine on a single node).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Launch stage: waitlist | early-access | public (default). During the gated
# stages the site converts to the waitlist and signup requires one of the
# comma-separated invite codes. Flip to "public" to open signup — no deploy
# of code, no rebuild.
# ---------------------------------------------------------------------------
LAUNCH_STAGE="waitlist"
WAITLIST_INVITE_CODES=""

# Public links on the waitlist page. Each social mark is linked only once its
# URL is set here; leave blank until the account exists.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_TIKTOK=""
NEXT_PUBLIC_SOCIAL_X=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""

# ---------------------------------------------------------------------------
# AI economics safeguards (optional; sensible defaults apply)
# ---------------------------------------------------------------------------
# Model that serves read-only questions (the "light" tier). Default
# claude-haiku-4-5; set to "off" to serve everything with ANTHROPIC_MODEL.
AI_LIGHT_MODEL=
# Estimated spend one assistant request may reach before it is stopped (USD, default 0.60).
AI_REQUEST_SPEND_CEILING_USD=
# Halyard-wide daily brake: when today's estimated spend across every
# organization passes this (USD), the assistant pauses until tomorrow. Unset = none.
AI_PLATFORM_DAILY_SPEND_CEILING_USD=
# Comma-separated emails allowed to open the platform economics report
# (/admin/platform/economics). Nothing in the database grants this.
HALYARD_PLATFORM_ADMINS=
